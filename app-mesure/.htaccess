# Toise — site statique (sous-domaine de clipscuts.com)
# Règles propres à ce dossier : celles du WordPress parent ne s'appliquent pas ici.
RewriteEngine On

# HTTPS obligatoire : caméra, capteurs de mouvement et GPS ne fonctionnent qu'en HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
Options -Indexes

<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  # Toujours revalider la page, le script et le service worker : les mises à jour arrivent tout de suite
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self)"
</IfModule>
